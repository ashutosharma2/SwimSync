# Local PostgreSQL over the Unix socket, no password. Copy to .env if you need to change it.
DATABASE_URL=postgresql:///swimsync
# The tests use their own database, which they reset before every test.
TEST_DATABASE_URL=postgresql:///swimsync_test
# Operator endpoints (/operator/...) are refused unless this is set. Demo stand-in for operator sign-in:
# choose your own long random value locally, never commit a real one.
SWIMSYNC_OPERATOR_TOKEN=
